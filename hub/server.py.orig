#!/usr/bin/env python3
"""NUC Homelab Hub — Backend API"""

from flask import Flask, jsonify, request, send_from_directory
import subprocess, socket, os, time, json
import psutil
import socket

app = Flask(__name__, static_folder=".")


def get_local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

SERVER_IP = get_local_ip()

