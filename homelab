#!/usr/bin/env bash
# homelab - an app store for your own server
#
# Nothing changes without --apply, and --apply refuses on any host that has not
# opted in via /etc/homelab/allow-apply.

set -euo pipefail

HOMELAB_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export HOMELAB_ROOT
# shellcheck disable=SC1091
. "$HOMELAB_ROOT/lib/common.sh"
. "$HOMELAB_ROOT/lib/detect.sh"
. "$HOMELAB_ROOT/lib/catalog.sh"

HOMELAB_APPLY=0
JSON=0
ALL=0
PURGE=0
export HOMELAB_APPLY

usage() {
cat <<'USAGE'
homelab - an app store for your own server

usage: homelab <command> [app] [options]

  detect                 what this machine is and what it already runs
  list                   the catalog, and what is installed here
  info <app>             details for one app
  status [app] [--all]   current state (one JSON line per app with --json)

  setup                  pick apps from the store and install them (start here
                         on a new machine)
  deploy                 copy this working tree to /opt/homelab, which is the
                         copy the hub reads. Run after adding or editing apps.
  install <app>...       download + start, one or more apps
  download <app>         fetch/build only, do not start
  start|stop|restart <app>
  update <app>
  delete <app> [--purge] --purge also destroys its data

  backup <app> <dir>
  restore <app> <dir>

options:
  --apply       actually do it. Without this, every command is a dry run
                that only prints what it would do.
  --json        machine-readable output (used by the hub)
  --all         with status: every app in the catalog
  --debug       trace dispatch

Nothing changes without --apply. --apply additionally refuses to run unless
/etc/homelab/allow-apply exists on this host.
USAGE
}

# ------------------------------------------------------------------ args

CMD="${1:-}"; [ $# -gt 0 ] && shift || true
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --apply)  HOMELAB_APPLY=1 ;;
        --json)   JSON=1 ;;
        --all)    ALL=1 ;;
        --purge)  PURGE=1 ;;
        --debug)  HOMELAB_DEBUG=1; export HOMELAB_DEBUG ;;
        -h|--help) usage; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *)  ARGS+=("$1") ;;
    esac
    shift
done
export HOMELAB_APPLY
require_apply_allowed

# Read a line from the terminal when there is one, else from stdin -- so the
# picker works interactively AND when driven by a pipe or a script.
# `[ -r /dev/tty ]` is not enough: on a non-interactive ssh the node exists and
# tests readable, but opening it fails with ENXIO.
ask() {
    local __var="$1" __line=""
    if { exec 3</dev/tty; } 2>/dev/null; then
        IFS= read -r __line <&3 || true
        exec 3<&-
    else
        IFS= read -r __line || true
    fi
    printf -v "$__var" '%s' "$__line"
}

banner_mode() {
    if is_apply; then
        printf '%s[APPLY]%s changes will be made to this machine\n' "$C_YEL$C_B" "$C_RST" >&2
    else
        printf '%s[dry-run]%s nothing will change. add --apply to do it for real.%s\n' \
            "$C_DIM" "$C_RST" "" >&2
    fi
}

# ------------------------------------------------------------------ commands

cmd_detect() {
    if [ "$JSON" = 1 ]; then detect_json; else detect_print; fi
}

cmd_list() {
    if [ "$JSON" = 1 ]; then
        local first=1; printf '['
        for n in $(catalog_names); do
            app_load "$n"
            [ $first = 1 ] || printf ','; first=0
            printf '{"app":"%s","title":"%s","category":"%s","kind":"%s","desc":"%s","ports":"%s","presence":"%s"}' \
                "$n" "$(json_escape "$APP_TITLE")" "$APP_CATEGORY" "$APP_KIND" \
                "$(json_escape "$APP_DESC")" "$APP_PORTS" "$(app_probe)"
        done
        printf ']\n'; return
    fi

    local cat last=""
    for n in $(catalog_names); do
        app_load "$n"
        printf '%s\t%s\t%s\t%s\n' "$APP_CATEGORY" "$n" "$APP_TITLE" "$(app_probe)"
    done | sort | while IFS=$'\t' read -r cat name title presence; do
        if [ "$cat" != "$last" ]; then
            printf '\n%s%s%s\n' "$C_B" "$cat" "$C_RST"; last="$cat"
        fi
        case "$presence" in
            installed) mark="${C_GRN}installed${C_RST}" ;;
            partial)   mark="${C_YEL}partial${C_RST}" ;;
            absent)    mark="${C_DIM}-${C_RST}" ;;
            *)         mark="${C_DIM}?${C_RST}" ;;
        esac
        printf '  %-16s %-28s %s\n' "$name" "$title" "$mark"
    done
    printf '\n'
}

cmd_info() {
    local n="${ARGS[0]:?usage: homelab info <app>}"
    app_load "$n"
    printf '%s%s%s  (%s)\n' "$C_B" "$APP_TITLE" "$C_RST" "$APP_NAME"
    printf '  %s\n\n' "$APP_DESC"
    printf '  kind        %s\n' "$APP_KIND"
    printf '  category    %s\n' "$APP_CATEGORY"
    [ -n "$APP_PORTS" ]    && printf '  ports       %s\n' "$APP_PORTS"
    [ -n "$APP_REQUIRES" ] && printf '  requires    %s\n' "$APP_REQUIRES"
    [ "$APP_RAM" != 0 ]    && printf '  needs ram   %s MB\n' "$APP_RAM"
    [ "$APP_DISK" != 0 ]   && printf '  needs disk  %s MB\n' "$APP_DISK"
    printf '  stateful    %s\n' "$([ "$APP_STATEFUL" = 1 ] && echo 'yes - has data worth backing up' || echo no)"
    printf '  presence    %s\n' "$(app_probe)"
    [ -n "$APP_HOMEPAGE" ] && printf '  homepage    %s\n' "$APP_HOMEPAGE"
    if [ -n "$APP_NOTES" ]; then printf '\n  %s\n' "$APP_NOTES"; fi
    printf '\n  implements  '
    local v found=""
    for v in download start stop update delete status backup restore; do
        if app_verb_impl "$n" "$v" 2>/dev/null; then
            [ -x "$APP_DIR/$v.sh" ] && found+="$v* " || found+="$v "
        fi
    done
    printf '%s\n' "$found"
    if printf '%s' "$found" | grep -q ' [a-z]*[^*] '; then
        printf '              %s(* = its own; the rest inherited from kind=%s)%s\n' "$C_DIM" "$APP_KIND" "$C_RST"
    else
        printf '              %s(all implemented by the app itself)%s\n' "$C_DIM" "$C_RST"
    fi
}

cmd_status() {
    local names
    if [ "${#ARGS[@]}" -gt 0 ]; then names="${ARGS[0]}"
    elif [ "$ALL" = 1 ]; then names="$(catalog_names)"
    else names="$(catalog_names)"; fi

    if [ "$JSON" = 1 ]; then
        for n in $names; do app_run_verb "$n" status || true; done
        return
    fi
    printf '%-16s %-12s %-10s %s\n' APP STATE HEALTH DETAIL
    for n in $names; do
        local line; line="$(app_run_verb "$n" status 2>/dev/null || echo '{}')"
        local st he co
        st="$(printf '%s' "$line" | sed -n 's/.*"state":"\([^"]*\)".*/\1/p')"
        he="$(printf '%s' "$line" | sed -n 's/.*"health":"\([^"]*\)".*/\1/p')"
        co="$(printf '%s' "$line" | sed -n 's/.*"containers":"\([^"]*\)".*/\1/p')"
        case "$st" in
            running)  c="$C_GRN" ;;
            degraded) c="$C_YEL" ;;
            stopped)  c="$C_DIM" ;;
            absent|"") c="$C_DIM"; st="${st:-unknown}" ;;
            *) c="$C_RED" ;;
        esac
        printf '%-16s %b%-12s%b %-10s %s\n' "$n" "$c" "$st" "$C_RST" "${he:--}" "${co:-}"
    done
}

# Resolve requires= into an install order, depth-first, without duplicates.
resolve_deps() {
    local n="$1" seen="${2:-}"
    case " $seen " in *" $n "*) return 0 ;; esac
    app_load "$n"
    local req
    for req in $APP_REQUIRES; do
        catalog_exists "$req" || die "$n requires '$req', which is not in the catalog"
        resolve_deps "$req" "$seen $n"
    done
    printf '%s\n' "$n"
}

# Resolve a set of apps into one dependency-ordered install list, so
# `install a b c` installs shared prerequisites once rather than per app.
plan_for() {
    local a
    for a in "$@"; do
        catalog_exists "$a" || die "no such app: $a  (try: homelab list)"
        resolve_deps "$a"
    done | awk '!seen[$0]++'
}

install_apps() {   # install_apps <app>...
    local order; order="$(plan_for "$@")"
    local cnt; cnt="$(printf '%s\n' "$order" | grep -c .)"
    log "install order ($cnt): $(printf '%s ' $order)"
    local a rc failed=""
    for a in $order; do
        log "--- $a: download ---"
        set +e; app_run_verb "$a" download; rc=$?; set -e
        if [ $rc != 0 ] && [ $rc != "$EX_NOOP" ]; then
            err "$a: download failed (rc=$rc)"; failed+="$a "; continue
        fi
        log "--- $a: start ---"
        set +e; app_run_verb "$a" start; rc=$?; set -e
        if [ $rc != 0 ] && [ $rc != "$EX_NOOP" ]; then
            err "$a: start failed (rc=$rc)"; failed+="$a "; continue
        fi
    done

    echo >&2
    if is_apply; then
        for a in $order; do
            case " $failed " in *" $a "*) continue ;; esac
            app_load "$a"
            if [ -n "$APP_PORTS" ]; then
                ok "$a  ->  http://${DET_IP:-localhost}:${APP_PORTS%% *}"
            else
                ok "$a"
            fi
        done
    else
        printf '%sdry run finished. re-run with --apply to actually do it.%s\n' \
            "$C_DIM" "$C_RST" >&2
    fi
    if [ -n "$failed" ]; then
        err "failed: $failed"
        return 1
    fi
}

cmd_install() {
    [ "${#ARGS[@]}" -gt 0 ] || die "usage: homelab install <app>... "
    banner_mode
    detect_host
    install_apps "${ARGS[@]}"
}

# The front door on a new machine: what is this box, what is on offer,
# what do you want.
cmd_setup() {
    detect_host
    printf '\n%s== this machine ==%s\n' "$C_B" "$C_RST"
    printf '  %s, %s cores, %s MB RAM, %s MB free on /\n' \
        "$DET_OS_NAME" "$DET_CPUS" "$DET_RAM_MB" "${DET_DISK_FREE_MB:-?}"
    printf '  docker: %s   mesh: %s   gpu: %s\n' "$DET_DOCKER" "$DET_MESH" "$DET_GPU"
    if [ "$DET_FAMILY" = unknown ]; then
        warn "unrecognised distro - most apps will refuse to install"
    fi

    printf '\n%s== the store ==%s\n' "$C_B" "$C_RST"
    local -a names=()
    local i=0 lastcat=""
    local line
    while IFS=$'\t' read -r cat name; do
        [ -n "$name" ] || continue
        app_load "$name"
        if [ "$cat" != "$lastcat" ]; then
            printf '\n  %s%s%s\n' "$C_DIM" "$cat" "$C_RST"; lastcat="$cat"
        fi
        i=$((i+1)); names[i]="$name"
        local p; p="$(app_probe)"
        local mark="  "
        case "$p" in
            installed) mark="${C_GRN}on${C_RST}" ;;
            partial)   mark="${C_YEL}~~${C_RST}" ;;
        esac
        printf '   %b %2d) %-14s %-26s %s%s%s\n' "$mark" "$i" "$name" "$APP_TITLE" \
            "$C_DIM" "${APP_DESC:0:46}" "$C_RST"
    done < <(for n in $(catalog_names); do
                 app_load "$n"; printf '%s\t%s\n' "$APP_CATEGORY" "$n"
             done | sort)

    if [ "$i" -eq 0 ]; then die "the catalog is empty"; fi

    printf '\n%sPick what you want.%s numbers and/or names, space separated.\n' "$C_B" "$C_RST"
    printf '  %s"all" for everything, "none"/Enter to cancel. Dependencies are added for you.%s\n' \
        "$C_DIM" "$C_RST"
    printf '> '
    local sel; ask sel

    local -a want=()
    case "${sel:-}" in
        ""|none|n|q|quit) log "nothing selected"; return 0 ;;
        all) want=("${names[@]:1:$i}") ;;
        *)
            local tok
            for tok in $sel; do
                if [ -z "${tok//[0-9]/}" ]; then
                    [ "$tok" -ge 1 ] && [ "$tok" -le "$i" ] \
                        || die "no item numbered $tok"
                    want+=("${names[$tok]}")
                else
                    catalog_exists "$tok" || die "no such app: $tok"
                    want+=("$tok")
                fi
            done
            ;;
    esac

    printf '\n'
    log "selected: ${want[*]}"
    local order; order="$(plan_for "${want[@]}")"
    printf '%swill install, in order:%s %s\n' "$C_B" "$C_RST" "$(printf '%s ' $order)"

    if ! is_apply; then
        printf '\n%sThis is a dry run - nothing will change.%s\n' "$C_YEL" "$C_RST" >&2
        printf '%sRe-run as: homelab setup --apply%s\n\n' "$C_DIM" "$C_RST" >&2
    else
        printf '\nProceed? [y/N] '
        local yn; ask yn
        case "$yn" in [yY]*) ;; *) log "cancelled"; return 0 ;; esac
    fi
    printf '\n'
    install_apps "${want[@]}"
}

# The hub runs /opt/homelab/homelab, not your checkout, so a new app is
# invisible to it until the engine is redeployed. That was previously a side
# effect of `update hub`, which is not a thing anyone would guess.
cmd_deploy() {
    local dest=/opt/homelab
    banner_mode
    if [ "$HOMELAB_ROOT" = "$dest" ]; then
        ok "already running from $dest - nothing to copy"
        exit $EX_NOOP
    fi
    log "deploying $HOMELAB_ROOT -> $dest"
    run $SUDO mkdir -p "$dest"
    run_sh "$SUDO tar -cf - -C '$HOMELAB_ROOT' --exclude=.git --exclude=testenv/golden --exclude=testenv/run . | $SUDO tar -xf - -C '$dest'"
    run $SUDO chmod 0755 "$dest/homelab"
    run $SUDO ln -sfn "$dest/homelab" /usr/local/bin/homelab
    if have systemctl && $SUDO systemctl is-active --quiet homelab-hub 2>/dev/null; then
        log "restarting the hub so it picks up the new catalog"
        run $SUDO systemctl restart homelab-hub
    fi
    ok "deployed"
}

cmd_simple() {  # start|stop|update
    local verb="$1" n="${ARGS[0]:?usage: homelab $1 <app>}"
    banner_mode
    set +e; app_run_verb "$n" "$verb"; local rc=$?; set -e
    # Propagate EX_NOOP rather than flattening it to 0. "already running" is
    # part of the contract, and callers (the hub, the conformance suite) need
    # to be able to tell it apart from "I just did the work".
    exit $rc
}

cmd_restart() {
    local n="${ARGS[0]:?usage: homelab restart <app>}"
    banner_mode
    set +e; app_run_verb "$n" stop; set -e     # a stopped app is fine to "restart"
    set +e; app_run_verb "$n" start; local rc=$?; set -e
    exit $rc
}

cmd_delete() {
    local n="${ARGS[0]:?usage: homelab delete <app> [--purge]}"
    banner_mode
    if [ "$PURGE" = 1 ] && is_apply; then
        app_load "$n"
        if [ "$APP_STATEFUL" = 1 ]; then
            warn "$n holds data. --purge will destroy it permanently."
            printf 'type the app name to confirm: ' >&2
            read -r confirm
            [ "$confirm" = "$n" ] || die "aborted"
        fi
    fi
    set +e
    if [ "$PURGE" = 1 ]; then app_run_verb "$n" delete --purge; else app_run_verb "$n" delete; fi
    local rc=$?; set -e
    exit $rc
}

cmd_backup() {
    local n="${ARGS[0]:?usage: homelab backup <app> <dir>}"
    local d="${ARGS[1]:?usage: homelab backup <app> <dir>}"
    banner_mode
    app_run_verb "$n" backup "$d"
}

cmd_restore() {
    local n="${ARGS[0]:?usage: homelab restore <app> <dir>}"
    local d="${ARGS[1]:?usage: homelab restore <app> <dir>}"
    banner_mode
    app_run_verb "$n" restore "$d"
}

case "$CMD" in
    detect)  cmd_detect ;;
    list|ls) cmd_list ;;
    info)    cmd_info ;;
    status)  cmd_status ;;
    install) cmd_install ;;
    setup)   cmd_setup ;;
    deploy)  cmd_deploy ;;
    download|start|stop|update) cmd_simple "$CMD" ;;
    restart) cmd_restart ;;
    delete|remove) cmd_delete ;;
    backup)  cmd_backup ;;
    restore) cmd_restore ;;
    ""|help|-h|--help) usage ;;
    *) err "unknown command: $CMD"; echo; usage; exit 1 ;;
esac
