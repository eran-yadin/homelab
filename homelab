#!/usr/bin/env bash
# homelab - an app store for your own server
#
# Nothing changes without --apply, and --apply refuses on any host that has not
# opted in via /etc/homelab/allow-apply.

set -euo pipefail

HOMELAB_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export HOMELAB_ROOT
# shellcheck disable=SC1091
. "$HOMELAB_ROOT/lib/common.sh"
. "$HOMELAB_ROOT/lib/detect.sh"
. "$HOMELAB_ROOT/lib/catalog.sh"

HOMELAB_APPLY=0
JSON=0
ALL=0
PURGE=0
MIGRATE_FROM=""
DEPLOY_FROM=""
DETACH=0
CHANNEL=stable
TO_TAG=""
export HOMELAB_APPLY

usage() {
cat <<'USAGE'
homelab - an app store for your own server

usage: homelab <command> [app] [options]

  detect                 what this machine is and what it already runs
  list                   the catalog, and what is installed here
  info <app>             details for one app
  status [app] [--all]   current state (one JSON line per app with --json)

  setup                  pick apps from the store and install them (start here
                         on a new machine)
  deploy [--from <dir>]  copy a working tree to /opt/homelab, which is the copy
                         the hub reads. Run after adding or editing apps.
                         --from lets the deployed copy update itself from a
                         checkout, which is what the hub's sudoers rule allows.
  install <app>...       download + start, one or more apps
  download <app>         fetch/build only, do not start
  start|stop|restart <app>
  update <app>
  update self [--channel stable|main] [--to <tag>] [--from <dir>] [--detach]
                         fetch from GitHub, back up what is deployed, deploy,
                         smoke-test, roll back on failure. The default channel,
                         stable, installs the newest v* tag and never moves
                         backwards on its own; --channel main follows the
                         branch; --to v1.2.0 installs exactly that tag, older
                         or newer. --detach runs it as its own systemd unit
                         and returns at once, with output in
                         /var/lib/homelab-hub/update.log; that is what the
                         hub's Update button uses, because the update restarts
                         the hub and a restart kills the hub's children.
  version                which release is deployed here (from VERSION)
  delete <app> [--purge] --purge also destroys its data

  backup <app> <dir>
  restore <app> <dir>
  migrate <app> --from [user@]host:/dir
                         fetch a backup from another machine and bring the app
                         up here, in the one order that is safe

options:
  --apply       actually do it. Without this, every command is a dry run
                that only prints what it would do.
  --json        machine-readable output (used by the hub)
  --all         with status: every app in the catalog
  --debug       trace dispatch

Nothing changes without --apply. --apply additionally refuses to run unless
/etc/homelab/allow-apply exists on this host.
USAGE
}

# ------------------------------------------------------------------ args

CMD="${1:-}"; [ $# -gt 0 ] && shift || true
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --apply)  HOMELAB_APPLY=1 ;;
        --json)   JSON=1 ;;
        --all)    ALL=1 ;;
        --purge)  PURGE=1 ;;
        --from)   shift; MIGRATE_FROM="${1:-}"; DEPLOY_FROM="${1:-}" ;;
        --detach) DETACH=1 ;;
        --channel) shift; CHANNEL="${1:-}" ;;
        --to)     shift; TO_TAG="${1:-}" ;;
        --debug)  HOMELAB_DEBUG=1; export HOMELAB_DEBUG ;;
        -h|--help) usage; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *)  ARGS+=("$1") ;;
    esac
    shift
done
export HOMELAB_APPLY
require_apply_allowed

# Read a line from the terminal when there is one, else from stdin -- so the
# picker works interactively AND when driven by a pipe or a script.
# `[ -r /dev/tty ]` is not enough: on a non-interactive ssh the node exists and
# tests readable, but opening it fails with ENXIO.
ask() {
    local __var="$1" __line=""
    if { exec 3</dev/tty; } 2>/dev/null; then
        IFS= read -r __line <&3 || true
        exec 3<&-
    else
        IFS= read -r __line || true
    fi
    printf -v "$__var" '%s' "$__line"
}

banner_mode() {
    if is_apply; then
        printf '%s[APPLY]%s changes will be made to this machine\n' "$C_YEL$C_B" "$C_RST" >&2
    else
        printf '%s[dry-run]%s nothing will change. add --apply to do it for real.%s\n' \
            "$C_DIM" "$C_RST" "" >&2
    fi
}

# ------------------------------------------------------------------ commands

cmd_detect() {
    if [ "$JSON" = 1 ]; then detect_json; else detect_print; fi
}

cmd_list() {
    if [ "$JSON" = 1 ]; then
        local first=1; printf '['
        for n in $(catalog_names); do
            app_load "$n"
            [ $first = 1 ] || printf ','; first=0
            printf '{"app":"%s","title":"%s","category":"%s","kind":"%s","desc":"%s","ports":"%s","presence":"%s"}' \
                "$n" "$(json_escape "$APP_TITLE")" "$APP_CATEGORY" "$APP_KIND" \
                "$(json_escape "$APP_DESC")" "$APP_PORTS" "$(app_probe)"
        done
        printf ']\n'; return
    fi

    local cat last=""
    for n in $(catalog_names); do
        app_load "$n"
        printf '%s\t%s\t%s\t%s\n' "$APP_CATEGORY" "$n" "$APP_TITLE" "$(app_probe)"
    done | sort | while IFS=$'\t' read -r cat name title presence; do
        if [ "$cat" != "$last" ]; then
            printf '\n%s%s%s\n' "$C_B" "$cat" "$C_RST"; last="$cat"
        fi
        case "$presence" in
            installed) mark="${C_GRN}installed${C_RST}" ;;
            partial)   mark="${C_YEL}partial${C_RST}" ;;
            absent)    mark="${C_DIM}-${C_RST}" ;;
            *)         mark="${C_DIM}?${C_RST}" ;;
        esac
        printf '  %-16s %-28s %s\n' "$name" "$title" "$mark"
    done
    printf '\n'
}

cmd_info() {
    local n="${ARGS[0]:?usage: homelab info <app>}"
    app_load "$n"
    printf '%s%s%s  (%s)\n' "$C_B" "$APP_TITLE" "$C_RST" "$APP_NAME"
    printf '  %s\n\n' "$APP_DESC"
    printf '  kind        %s\n' "$APP_KIND"
    printf '  category    %s\n' "$APP_CATEGORY"
    [ -n "$APP_PORTS" ]    && printf '  ports       %s\n' "$APP_PORTS"
    [ -n "$APP_REQUIRES" ] && printf '  requires    %s\n' "$APP_REQUIRES"
    [ "$APP_RAM" != 0 ]    && printf '  needs ram   %s MB\n' "$APP_RAM"
    [ "$APP_DISK" != 0 ]   && printf '  needs disk  %s MB\n' "$APP_DISK"
    printf '  stateful    %s\n' "$([ "$APP_STATEFUL" = 1 ] && echo 'yes - has data worth backing up' || echo no)"
    printf '  presence    %s\n' "$(app_probe)"
    [ -n "$APP_HOMEPAGE" ] && printf '  homepage    %s\n' "$APP_HOMEPAGE"
    if [ -n "$APP_NOTES" ]; then printf '\n  %s\n' "$APP_NOTES"; fi
    printf '\n  implements  '
    local v found=""
    for v in download start stop update delete status backup restore; do
        if app_verb_impl "$n" "$v" 2>/dev/null; then
            [ -x "$APP_DIR/$v.sh" ] && found+="$v* " || found+="$v "
        fi
    done
    printf '%s\n' "$found"
    if printf '%s' "$found" | grep -q ' [a-z]*[^*] '; then
        printf '              %s(* = its own; the rest inherited from kind=%s)%s\n' "$C_DIM" "$APP_KIND" "$C_RST"
    else
        printf '              %s(all implemented by the app itself)%s\n' "$C_DIM" "$C_RST"
    fi
}

cmd_status() {
    local names
    if [ "${#ARGS[@]}" -gt 0 ]; then names="${ARGS[0]}"
    elif [ "$ALL" = 1 ]; then names="$(catalog_names)"
    else names="$(catalog_names)"; fi

    if [ "$JSON" = 1 ]; then
        for n in $names; do app_run_verb "$n" status || true; done
        return
    fi
    printf '%-16s %-12s %-10s %s\n' APP STATE HEALTH DETAIL
    for n in $names; do
        local line; line="$(app_run_verb "$n" status 2>/dev/null || echo '{}')"
        local st he co
        st="$(printf '%s' "$line" | sed -n 's/.*"state":"\([^"]*\)".*/\1/p')"
        he="$(printf '%s' "$line" | sed -n 's/.*"health":"\([^"]*\)".*/\1/p')"
        co="$(printf '%s' "$line" | sed -n 's/.*"containers":"\([^"]*\)".*/\1/p')"
        case "$st" in
            running)  c="$C_GRN" ;;
            degraded) c="$C_YEL" ;;
            stopped)  c="$C_DIM" ;;
            absent|"") c="$C_DIM"; st="${st:-unknown}" ;;
            *) c="$C_RED" ;;
        esac
        printf '%-16s %b%-12s%b %-10s %s\n' "$n" "$c" "$st" "$C_RST" "${he:--}" "${co:-}"
    done
}

# Resolve requires= into an install order, depth-first, without duplicates.
resolve_deps() {
    local n="$1" seen="${2:-}"
    case " $seen " in *" $n "*) return 0 ;; esac
    app_load "$n"
    local req
    for req in $APP_REQUIRES; do
        catalog_exists "$req" || die "$n requires '$req', which is not in the catalog"
        resolve_deps "$req" "$seen $n"
    done
    printf '%s\n' "$n"
}

# Resolve a set of apps into one dependency-ordered install list, so
# `install a b c` installs shared prerequisites once rather than per app.
plan_for() {
    local a
    for a in "$@"; do
        catalog_exists "$a" || die "no such app: $a  (try: homelab list)"
        resolve_deps "$a"
    done | awk '!seen[$0]++'
}

install_apps() {   # install_apps <app>...
    local order; order="$(plan_for "$@")"
    local cnt; cnt="$(printf '%s\n' "$order" | grep -c .)"
    log "install order ($cnt): $(printf '%s ' $order)"
    # Apps declare needs_disk_mb and nothing ever checked it. Running out of
    # space mid-install does not say so: apt fails to write its index and then
    # reports "Unable to locate package", which reads as a missing repository.
    local a
    for a in $order; do
        app_load "$a"
        [ "${APP_DISK:-0}" -gt 0 ] 2>/dev/null || continue
        local target=/ free
        if [ "$APP_KIND" = compose ] && [ -d /var/lib/docker ]; then
            target=/var/lib/docker
        fi
        free="$(df -Pm "$target" 2>/dev/null | awk 'NR==2{print $4}')"
        [ -n "$free" ] || continue
        if [ "$free" -lt "$APP_DISK" ]; then
            err "$a wants about ${APP_DISK} MB on $target, but ${free} MB is free."
            err "    Stopping here rather than failing partway through: out of space"
            err "    rarely says so. apt reports 'Unable to locate package' when it"
            err "    cannot write its index, which looks like a missing repository."
            exit 1
        fi
    done

    local rc failed=""
    for a in $order; do
        log "--- $a: download ---"
        set +e; app_run_verb "$a" download; rc=$?; set -e
        if [ $rc != 0 ] && [ $rc != "$EX_NOOP" ]; then
            err "$a: download failed (rc=$rc)"; failed+="$a "; continue
        fi
        log "--- $a: start ---"
        set +e; app_run_verb "$a" start; rc=$?; set -e
        if [ $rc != 0 ] && [ $rc != "$EX_NOOP" ]; then
            err "$a: start failed (rc=$rc)"; failed+="$a "; continue
        fi
    done

    echo >&2
    if is_apply; then
        for a in $order; do
            case " $failed " in *" $a "*) continue ;; esac
            app_load "$a"
            if [ -n "$APP_PORTS" ]; then
                ok "$a  ->  http://${DET_IP:-localhost}:${APP_PORTS%% *}"
            else
                ok "$a"
            fi
        done
    else
        printf '%sdry run finished. re-run with --apply to actually do it.%s\n' \
            "$C_DIM" "$C_RST" >&2
    fi
    if [ -n "$failed" ]; then
        err "failed: $failed"
        return 1
    fi
}

cmd_install() {
    [ "${#ARGS[@]}" -gt 0 ] || die "usage: homelab install <app>... "
    banner_mode
    detect_host
    install_apps "${ARGS[@]}"
}

# The front door on a new machine: what is this box, what is on offer,
# what do you want.
cmd_setup() {
    detect_host
    printf '\n%s== this machine ==%s\n' "$C_B" "$C_RST"
    printf '  %s, %s cores, %s MB RAM, %s MB free on /\n' \
        "$DET_OS_NAME" "$DET_CPUS" "$DET_RAM_MB" "${DET_DISK_FREE_MB:-?}"
    printf '  docker: %s   mesh: %s   gpu: %s\n' "$DET_DOCKER" "$DET_MESH" "$DET_GPU"
    if [ "$DET_FAMILY" = unknown ]; then
        warn "unrecognised distro - most apps will refuse to install"
    fi

    printf '\n%s== the store ==%s\n' "$C_B" "$C_RST"
    local -a names=()
    local i=0 lastcat=""
    local line
    while IFS=$'\t' read -r cat name; do
        [ -n "$name" ] || continue
        app_load "$name"
        if [ "$cat" != "$lastcat" ]; then
            printf '\n  %s%s%s\n' "$C_DIM" "$cat" "$C_RST"; lastcat="$cat"
        fi
        i=$((i+1)); names[i]="$name"
        local p; p="$(app_probe)"
        local mark="  "
        case "$p" in
            installed) mark="${C_GRN}on${C_RST}" ;;
            partial)   mark="${C_YEL}~~${C_RST}" ;;
        esac
        printf '   %b %2d) %-14s %-26s %s%s%s\n' "$mark" "$i" "$name" "$APP_TITLE" \
            "$C_DIM" "${APP_DESC:0:46}" "$C_RST"
    done < <(for n in $(catalog_names); do
                 app_load "$n"; printf '%s\t%s\n' "$APP_CATEGORY" "$n"
             done | sort)

    if [ "$i" -eq 0 ]; then die "the catalog is empty"; fi

    printf '\n%sPick what you want.%s numbers and/or names, space separated.\n' "$C_B" "$C_RST"
    printf '  %s"all" for everything, "none"/Enter to cancel. Dependencies are added for you.%s\n' \
        "$C_DIM" "$C_RST"
    printf '> '
    local sel; ask sel

    local -a want=()
    case "${sel:-}" in
        ""|none|n|q|quit) log "nothing selected"; return 0 ;;
        all) want=("${names[@]:1:$i}") ;;
        *)
            local tok
            for tok in $sel; do
                if [ -z "${tok//[0-9]/}" ]; then
                    [ "$tok" -ge 1 ] && [ "$tok" -le "$i" ] \
                        || die "no item numbered $tok"
                    want+=("${names[$tok]}")
                else
                    catalog_exists "$tok" || die "no such app: $tok"
                    want+=("$tok")
                fi
            done
            ;;
    esac

    printf '\n'
    log "selected: ${want[*]}"
    local order; order="$(plan_for "${want[@]}")"
    printf '%swill install, in order:%s %s\n' "$C_B" "$C_RST" "$(printf '%s ' $order)"

    if ! is_apply; then
        printf '\n%sThis is a dry run - nothing will change.%s\n' "$C_YEL" "$C_RST" >&2
        printf '%sRe-run as: homelab setup --apply%s\n\n' "$C_DIM" "$C_RST" >&2
    else
        printf '\nProceed? [y/N] '
        local yn; ask yn
        case "$yn" in [yY]*) ;; *) log "cancelled"; return 0 ;; esac
    fi
    printf '\n'
    install_apps "${want[@]}"
}

# The hub runs /opt/homelab/homelab, not your checkout, so a new app is
# invisible to it until the engine is redeployed. That was previously a side
# effect of `update hub`, which is not a thing anyone would guess.
#
# deploy_tree does the copy; cmd_deploy and cmd_update_self both use it.
deploy_tree() {  # deploy_tree <src>
    local src="$1" dest=/opt/homelab
    log "deploying $src -> $dest"
    run $SUDO mkdir -p "$dest"
    run_sh "$SUDO tar -cf - -C '$src' --exclude=.git --exclude=testenv/golden --exclude=testenv/run . | $SUDO tar -xf - -C '$dest'"
    run $SUDO chmod 0755 "$dest/homelab"
    run $SUDO ln -sfn "$dest/homelab" /usr/local/bin/homelab

    # Remember which commit is deployed, so `update self` can tell whether
    # GitHub has anything newer without guessing from file timestamps.
    local rev; rev="$(git_as_owner -C "$src" rev-parse HEAD 2>/dev/null || true)"
    local ver; ver="$(git_as_owner -C "$src" describe --tags --always 2>/dev/null || true)"
    if [ -n "$rev" ]; then
        printf '%s' "$rev" | run_write "$dest/.deployed-rev" 0644
        printf '%s' "$ver" | run_write "$dest/VERSION" 0644
    elif [ -f "$src/.deployed-rev" ]; then       # rolling back from a backup
        run $SUDO cp "$src/.deployed-rev" "$dest/.deployed-rev"
        [ -f "$src/VERSION" ] && run $SUDO cp "$src/VERSION" "$dest/VERSION"
    fi

    # The hub serves its own copy of server.py and index.html from
    # /opt/homelab-hub. Syncing the engine and restarting the service is not
    # enough -- the browser would keep getting the old page, which looks
    # exactly like the fix not working. Refresh the hub's files too.
    if [ -d /opt/homelab-hub ]; then
        log "refreshing the hub's own files"
        set +e; app_run_verb hub download; local hrc=$?; set -e
        [ $hrc = 0 ] || [ $hrc = "$EX_NOOP" ] || warn "hub file refresh returned $hrc"
    fi

    if have systemctl && systemctl is-active --quiet homelab-hub 2>/dev/null; then
        log "restarting the hub"
        run $SUDO systemctl restart homelab-hub
    fi
}

cmd_deploy() {
    local dest=/opt/homelab
    local src="${DEPLOY_FROM:-$HOMELAB_ROOT}"
    banner_mode
    src="$(cd "$src" 2>/dev/null && pwd)" || die "no such directory: ${DEPLOY_FROM:-$HOMELAB_ROOT}"
    [ -f "$src/homelab" ] || die "$src does not look like a homelab checkout"
    if [ "$src" = "$dest" ]; then
        ok "already running from $dest - nothing to copy"
        exit $EX_NOOP
    fi
    deploy_tree "$src"
    ok "deployed"
}

# ------------------------------------------------------------ update self
#
# `homelab update self`: the deployed engine updates itself from GitHub.
#
#   fetch -> compare -> back up -> pull -> deploy -> smoke test -> report,
#   and roll back to the backup if the smoke test fails.
#
# The hub calls us as root via `sudo -n /opt/homelab/homelab`, but the git
# checkout belongs to the human. git refuses to touch a repo owned by someone
# else ("dubious ownership"), and root-owned objects would break the human's
# next pull, so every git command runs as the checkout's owner.

UPDATE_UNIT=homelab-self-update
UPDATE_LOG=/var/lib/homelab-hub/update.log   # root writes, the hub user reads

git_as_owner() {
    local u; u="$(owner_user)"
    if [ "$(id -u)" -eq 0 ] && [ "$u" != root ]; then
        sudo -n -u "$u" git "$@"
    else
        git "$@"
    fi
}

owner_home() {
    local u; u="$(owner_user)"
    if [ -n "${SUDO_USER:-}" ]; then
        getent passwd "$u" | cut -d: -f6
    else
        printf '%s' "$HOME"
    fi
}

# "app=state" per line, from the deployed engine's own status --json.
snapshot_states() {  # snapshot_states <engine-dir>
    [ -x "$1/homelab" ] || return 0        # nothing deployed yet: empty snapshot
    "$1/homelab" status --json 2>/dev/null \
        | sed -n 's/.*"app":"\([^"]*\)".*"state":"\([^"]*\)".*/\1=\2/p' || true
}

hub_answers() {
    have python3 || return 0        # cannot probe; do not fail the update on it
    python3 -c '
import sys, urllib.request
try:
    with urllib.request.urlopen("http://127.0.0.1:7070/api/status", timeout=5) as r:
        sys.exit(0 if r.status == 200 else 1)
except Exception:
    sys.exit(1)'
}

# Returns 0 if the deployed engine looks healthy, 1 with reasons on stderr.
smoke_test() {  # smoke_test <engine-dir> <before-states>
    local engine="$1" before="$2" bad=0

    if have systemctl && systemctl is-enabled --quiet homelab-hub 2>/dev/null; then
        local i; for i in $(seq 1 20); do
            hub_answers && break
            sleep 1
        done
        if hub_answers; then ok "hub answers on :7070"
        else err "hub does not answer on :7070 after 20s"; bad=1; fi
    fi

    local out; out="$("$engine/homelab" status --json 2>/dev/null || true)"
    if [ -z "$out" ]; then
        err "'homelab status --json' produced no output"; bad=1
    elif have python3 && ! printf '%s\n' "$out" | python3 -c '
import json, sys
for line in sys.stdin:
    if line.strip(): json.loads(line)' 2>/dev/null; then
        err "'homelab status --json' is not valid JSON"; bad=1
    else
        ok "status --json is valid"
    fi

    local after; after="$(snapshot_states "$engine")"
    local pair app st
    for pair in $before; do
        app="${pair%%=*}"; st="${pair#*=}"
        [ "$st" = running ] || continue
        case "$(printf '%s\n' "$after" | sed -n "s/^$app=//p")" in
            running) ;;
            *) err "$app was running before the update and is not now"; bad=1 ;;
        esac
    done
    [ $bad = 0 ] && ok "every app that was running still is"
    return $bad
}

cmd_update_self() {
    local dest=/opt/homelab
    local src="${DEPLOY_FROM:-$(owner_home)/homelab}"
    banner_mode

    src="$(cd "$src" 2>/dev/null && pwd)" || die "no such directory: $src"
    [ -f "$src/homelab" ] || die "$src does not look like a homelab checkout"
    [ -d "$src/.git" ] || die "$src is not a git clone. update self pulls from GitHub, so:
    git clone https://github.com/eran-yadin/homelab.git $src"
    [ "$src" != "$dest" ] || die "refusing to update $dest from itself; --from must name a git checkout"

    # --- detach ---------------------------------------------------------------
    # The hub asks for this. It cannot run the update as a child: the update
    # restarts homelab-hub, systemd kills the service's whole cgroup on restart,
    # and the update would die halfway with the hub's files half-copied. A
    # transient unit lives in its own cgroup and outlives the restart. The hub
    # then tails the log, and closing the browser tab changes nothing.
    if [ "$DETACH" = 1 ]; then
        have systemd-run || die "--detach needs systemd-run"
        if systemctl is-active --quiet "$UPDATE_UNIT" 2>/dev/null; then
            die "an update is already running (unit $UPDATE_UNIT); its log is $UPDATE_LOG"
        fi
        local apply_flag=""; is_apply && apply_flag="--apply"
        run $SUDO mkdir -p "$(dirname "$UPDATE_LOG")"
        run_sh "$SUDO sh -c ': > \"$UPDATE_LOG\"'"
        # SUDO_USER is how the detached copy learns whose checkout this is;
        # systemd-run starts from a clean environment. The exit code goes into
        # the log as a marker line, which is what the hub's page waits for.
        run $SUDO systemd-run --unit="$UPDATE_UNIT" --collect --quiet --no-block \
            --description="homelab update self" \
            --setenv=SUDO_USER="$(owner_user)" --setenv=NO_COLOR=1 \
            --property=StandardOutput=append:"$UPDATE_LOG" \
            --property=StandardError=append:"$UPDATE_LOG" \
            /bin/bash -c 'printf "homelab update self started %s\n" "$(date -Iseconds)"; "$0" update self --from "$1" --channel "$3" ${4:+--to "$4"} $2; rc=$?; printf "__HOMELAB_UPDATE_DONE__ rc=%s\n" "$rc"; exit $rc' \
            "$HOMELAB_ROOT/homelab" "$src" "$apply_flag" "$CHANNEL" "$TO_TAG"
        ok "update running in the background as $UPDATE_UNIT; log: $UPDATE_LOG"
        return 0
    fi

    # --- fetch + choose the target ----------------------------------------------
    # fetch only touches .git, never the working tree, so it is safe in dry-run
    # and the comparison below is real either way.
    #
    # Releases are git tags. The stable channel installs the newest v* tag,
    # so a push to main changes nothing on this box until someone tags it.
    # That is the gate for the hub's Update button: it can only ever install a
    # state that was deliberately named.
    log "fetching origin in $src"
    git_as_owner -C "$src" fetch --quiet --tags --prune origin || die "git fetch failed"
    if [ -n "$(git_as_owner -C "$src" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
        die "$src has uncommitted changes. update self deploys the working tree, so
    commit or stash them first (or use 'homelab deploy --from $src' on purpose)."
    fi

    local deployed deployed_name target target_name branch=main
    deployed="$(cat "$dest/.deployed-rev" 2>/dev/null || true)"
    deployed_name="$(cat "$dest/VERSION" 2>/dev/null || true)"
    if [ -z "$deployed" ]; then deployed_name="none"
    elif [ -z "$deployed_name" ]; then
        deployed_name="$(git_as_owner -C "$src" describe --tags --always "$deployed" 2>/dev/null || echo unknown)"
    fi

    if [ -n "$TO_TAG" ]; then
        target_name="$TO_TAG"
        target="$(git_as_owner -C "$src" rev-parse -q --verify "refs/tags/$TO_TAG^{commit}" 2>/dev/null)" \
            || die "no such tag: $TO_TAG. Newest tags: $(git_as_owner -C "$src" tag -l 'v[0-9]*' --sort=-v:refname | head -5 | tr '\n' ' ')"
    elif [ "$CHANNEL" = stable ]; then
        target_name="$(git_as_owner -C "$src" tag -l 'v[0-9]*' --sort=-v:refname | head -1)"
        [ -n "$target_name" ] || die "no release tags on origin. The stable channel installs the newest v* tag:
    git tag -a v1.0.0 -m 'first release' && git push origin v1.0.0
or follow the branch instead with --channel main."
        target="$(git_as_owner -C "$src" rev-parse "refs/tags/$target_name^{commit}")"
    elif [ "$CHANNEL" = main ]; then
        branch="$(git_as_owner -C "$src" rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed 's|^origin/||')"
        branch="${branch:-main}"
        target_name="origin/$branch"
        target="$(git_as_owner -C "$src" rev-parse "origin/$branch" 2>/dev/null)" || die "origin has no branch '$branch'"
    else
        die "unknown channel: $CHANNEL (stable or main)"
    fi

    printf '   deployed  %-14s %s\n   target    %-14s %s  (%s)\n' \
        "$deployed_name" "${deployed:-unknown}" "$target_name" "$target" \
        "${TO_TAG:+pinned }${TO_TAG:-channel $CHANNEL}" >&2
    if [ "$deployed" = "$target" ]; then
        ok "already up to date at $target_name - nothing to do"
        exit $EX_NOOP
    fi
    # A channel never moves backwards by itself. If main was deployed by hand
    # and is ahead of the newest tag, the Update button must not undo that;
    # --to is the explicit way to go back.
    if [ -z "$TO_TAG" ] && [ -n "$deployed" ] \
       && git_as_owner -C "$src" merge-base --is-ancestor "$target" "$deployed" 2>/dev/null; then
        ok "deployed $deployed_name is ahead of $target_name - nothing to do (tag a new release to move $CHANNEL forward)"
        exit $EX_NOOP
    fi
    if [ -n "$deployed" ]; then
        if git_as_owner -C "$src" merge-base --is-ancestor "$deployed" "$target" 2>/dev/null; then
            log "changes $deployed_name -> $target_name:"
            git_as_owner -C "$src" log --oneline "$deployed..$target" 2>/dev/null | head -20 | sed 's/^/     /' >&2 || true
        else
            warn "going back: $deployed_name -> $target_name"
        fi
    fi

    # --- back up what is deployed ----------------------------------------------
    local bk; bk="$(owner_home)/backups/homelab-self-$(date +%Y%m%d-%H%M%S)"
    local before; before="$(snapshot_states "$dest")"

    # The engine is a few MB of scripts. Anything bigger in $dest is not the
    # engine -- the test VM's disk images have ended up there before, 44 GB of
    # them -- and copying that on every update filled the disk. Skip what the
    # deploy itself skips, and refuse outright if what is left is still big.
    local -a bk_excl=(--exclude=.git --exclude=testenv/golden --exclude=testenv/run
                      --exclude=./golden --exclude=./run --exclude='*.qcow2'
                      --exclude='*.img' --exclude=__pycache__)
    local bk_mb=0
    if [ -d "$dest" ]; then
        bk_mb="$(tar -cf - -C "$dest" "${bk_excl[@]}" . 2>/dev/null | wc -c || true)"
        bk_mb=$(( ${bk_mb:-0} / 1048576 ))
    fi
    if [ "$bk_mb" -gt 200 ]; then
        err "$dest is ${bk_mb} MB even after skipping VM images; the engine should be a few MB."
        err "    Something large is sitting in it. Largest entries:"
        du -sm "$dest"/* 2>/dev/null | sort -rn | head -5 | sed 's/^/        /' >&2
        die "move that out of $dest and run update self again"
    fi
    log "backing up $dest (${bk_mb} MB) and /opt/homelab-hub -> $bk"
    run mkdir -p "$bk/homelab"
    run_sh "tar -cf - -C '$dest' ${bk_excl[*]} . | tar -xf - -C '$bk/homelab'"
    if [ -d /opt/homelab-hub ]; then run cp -a /opt/homelab-hub "$bk/homelab-hub"; fi
    printf '%s\n' "$before" | run_write "$bk/status-before.txt" 0644
    run chown -R "$(owner_user):$(owner_group)" "$bk"

    # --- check out + deploy --------------------------------------------------------
    if [ -z "$TO_TAG" ] && [ "$CHANNEL" = main ]; then
        log "fast-forwarding $branch"
        run git_as_owner -C "$src" checkout --quiet "$branch"
        run git_as_owner -C "$src" merge --ff-only --quiet "$target" \
            || die "$src/$branch has commits that are not on origin; push or reset them first"
    else
        log "checking out $target_name"
        run git_as_owner -C "$src" checkout --quiet --detach "$target"
    fi
    deploy_tree "$src"

    if ! is_apply; then
        ok "would then smoke-test and roll back to $bk on failure"
        return 0
    fi

    # --- smoke test, roll back on failure ------------------------------------------
    log "smoke test"
    if smoke_test "$dest" "$before"; then
        ok "updated $deployed_name -> $target_name. backup: $bk"
        return 0
    fi
    err "smoke test failed - rolling back to $bk"
    deploy_tree "$bk/homelab"
    if smoke_test "$dest" "$before"; then
        die "rolled back to ${deployed:-the previous deploy}. the new code is still checked out in $src"
    fi
    die "rollback deployed but the smoke test still fails. backup is in $bk; the checkout is $src"
}

cmd_version() {
    # deploy_tree writes VERSION (git describe: v1.2.0, or v1.2.0-3-gabc1234
    # past a tag, or a bare hash before any tag). A checkout asks git directly.
    local v r
    v="$(cat "$HOMELAB_ROOT/VERSION" 2>/dev/null || true)"
    r="$(cat "$HOMELAB_ROOT/.deployed-rev" 2>/dev/null || true)"
    if [ -z "$v" ] && [ -d "$HOMELAB_ROOT/.git" ]; then
        v="$(git_as_owner -C "$HOMELAB_ROOT" describe --tags --always --dirty 2>/dev/null || true)"
        r="$(git_as_owner -C "$HOMELAB_ROOT" rev-parse HEAD 2>/dev/null || true)"
    fi
    if [ "$JSON" = 1 ]; then
        printf '{"version":"%s","rev":"%s"}\n' "$(json_escape "${v:-unknown}")" "$(json_escape "$r")"
    else
        printf '%s\n' "${v:-unknown}"
    fi
}

cmd_simple() {  # start|stop|update
    local verb="$1" n="${ARGS[0]:?usage: homelab $1 <app>}"
    banner_mode
    set +e; app_run_verb "$n" "$verb"; local rc=$?; set -e
    # Propagate EX_NOOP rather than flattening it to 0. "already running" is
    # part of the contract, and callers (the hub, the conformance suite) need
    # to be able to tell it apart from "I just did the work".
    exit $rc
}

cmd_restart() {
    local n="${ARGS[0]:?usage: homelab restart <app>}"
    banner_mode
    set +e; app_run_verb "$n" stop; set -e     # a stopped app is fine to "restart"
    set +e; app_run_verb "$n" start; local rc=$?; set -e
    exit $rc
}

cmd_delete() {
    local n="${ARGS[0]:?usage: homelab delete <app> [--purge]}"
    banner_mode
    if [ "$PURGE" = 1 ] && is_apply; then
        app_load "$n"
        if [ "$APP_STATEFUL" = 1 ]; then
            warn "$n holds data. --purge will destroy it permanently."
            printf 'type the app name to confirm: ' >&2
            read -r confirm
            [ "$confirm" = "$n" ] || die "aborted"
        fi
    fi
    set +e
    if [ "$PURGE" = 1 ]; then app_run_verb "$n" delete --purge; else app_run_verb "$n" delete; fi
    local rc=$?; set -e
    exit $rc
}

cmd_backup() {
    local n="${ARGS[0]:?usage: homelab backup <app> <dir>}"
    local d="${ARGS[1]:?usage: homelab backup <app> <dir>}"
    banner_mode
    app_run_verb "$n" backup "$d"
}

cmd_restore() {
    local n="${ARGS[0]:?usage: homelab restore <app> <dir>}"
    local d="${ARGS[1]:?usage: homelab restore <app> <dir>}"
    banner_mode
    app_run_verb "$n" restore "$d"
}

# Fetch a backup from the old machine and bring the app up here. The only
# reason this exists rather than three documented commands is the order:
# `install` starts the app, the database initialises a fresh cluster, and the
# restore then lands on live files. Doing it wrong is silent.
cmd_migrate() {
    local n="${ARGS[0]:?usage: homelab migrate <app> --from [user@]host:/dir}"
    catalog_exists "$n" || die "no such app: $n"
    [ -n "$MIGRATE_FROM" ] || die "migrate needs --from [user@]host:/dir"
    banner_mode
    detect_host

    local stage="$HOMELAB_DATA/migrate/$n"
    log "staging into $stage"
    run $SUDO mkdir -p "$stage"
    run $SUDO chown "$(owner_user):$(owner_group)" "$stage"

    log "fetching $MIGRATE_FROM"
    if is_apply; then
        have scp || die "scp is not installed; copy the backup here yourself and use: homelab restore $n <dir>"
        scp -r "$MIGRATE_FROM"/. "$stage"/ || die "could not fetch $MIGRATE_FROM"
        local count; count="$(find "$stage" -type f | wc -l)"
        [ "$count" -gt 0 ] || die "$stage is empty - nothing was fetched"
        ok "fetched $count files"
    else
        printf '%s     would run:%s scp -r %s/. %s/\n' "$C_DIM" "$C_RST" "$MIGRATE_FROM" "$stage" >&2
    fi

    local rc
    log "--- $n: download (images only) ---"
    set +e; app_run_verb "$n" download; rc=$?; set -e
    [ $rc = 0 ] || [ $rc = "$EX_NOOP" ] || die "$n: download failed"

    log "--- $n: restore (before anything starts) ---"
    set +e; app_run_verb "$n" restore "$stage"; rc=$?; set -e
    [ $rc = 0 ] || die "$n: restore failed"

    log "--- $n: start ---"
    set +e; app_run_verb "$n" start; rc=$?; set -e
    [ $rc = 0 ] || [ $rc = "$EX_NOOP" ] || die "$n: start failed"

    if is_apply; then
        ok "$n migrated. Check it, then remove the staging copy: sudo rm -rf $stage"
    fi
}

case "$CMD" in
    detect)  cmd_detect ;;
    list|ls) cmd_list ;;
    info)    cmd_info ;;
    status)  cmd_status ;;
    install) cmd_install ;;
    setup)   cmd_setup ;;
    deploy)  cmd_deploy ;;
    version|--version|-V) cmd_version ;;
    update)  if [ "${ARGS[0]:-}" = self ]; then cmd_update_self; else cmd_simple "$CMD"; fi ;;
    download|start|stop) cmd_simple "$CMD" ;;
    restart) cmd_restart ;;
    delete|remove) cmd_delete ;;
    backup)  cmd_backup ;;
    migrate) cmd_migrate ;;
    restore) cmd_restore ;;
    ""|help|-h|--help) usage ;;
    *) err "unknown command: $CMD"; echo; usage; exit 1 ;;
esac
