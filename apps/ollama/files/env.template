OLLAMA_PORT=11434

# How long a model stays resident after its last request. On a box that also
# runs other things, a short value frees VRAM between uses; the cost is a
# reload (5-15s) on the next request.
OLLAMA_KEEP_ALIVE=5m

# How many models may be loaded at once. Above 1 on a small GPU means they
# fight for VRAM and get evicted mid-conversation.
OLLAMA_MAX_LOADED_MODELS=1
