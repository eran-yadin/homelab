# Where your 3D model files live on the host. Change this, then:
#   homelab restart manyfold
MODELS_DIR=/srv/3dmodels

# Rails encryption key. Generated once; changing it invalidates stored sessions.
MANYFOLD_SECRET_KEY=@@SECRET:64@@

# Own the files as this user, so the library stays readable outside the container.
MANYFOLD_PUID=1000
MANYFOLD_PGID=1000
MANYFOLD_PORT=3214
