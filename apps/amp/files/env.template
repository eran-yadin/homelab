# The AMP web panel login, created at install time.
AMP_ADMIN_USER=admin
AMP_ADMIN_PASSWORD=@@SECRET:24@@

# Password for the `amp` system user the installer creates.
AMP_SYSTEM_PASSWORD=@@SECRET:32@@

# Install a JRE so Minecraft servers work out of the box.
AMP_INSTALL_JAVA=y

# 32-bit C++ libraries for Source engine games (CS, TF2, Garry's Mod).
AMP_INSTALL_SRCDS_LIBS=n

# Leave both of these alone unless you know why you are changing them.
#   Docker: this catalog installs and manages docker itself.
#   HTTPS:  getamp.sh implements this by installing and configuring nginx,
#           which would fight caddy for port 80. Put AMP behind caddy instead.
AMP_INSTALL_DOCKER=n
AMP_INSTALL_HTTPS=n
