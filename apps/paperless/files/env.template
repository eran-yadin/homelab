# Rendered once into /var/lib/homelab/apps/paperless/.env and never overwritten,
# so an update cannot rotate the DB password out from under postgres.
# `latest` follows paperless-ngx releases. `homelab update paperless` shows
# the version jump, backs up every volume first and asks before recreating,
# because an upgrade migrates the database and an export only imports into
# the version it came from. Pin a version here to stop updates instead.
PAPERLESS_VERSION=latest
PAPERLESS_DB_PASSWORD=@@SECRET:32@@
PAPERLESS_SECRET_KEY=@@SECRET:64@@
PAPERLESS_OCR_LANGUAGE=eng+heb
PAPERLESS_TIME_ZONE=Asia/Jerusalem
PAPERLESS_PORT=8010
PAPERLESS_URL=http://localhost:8010
