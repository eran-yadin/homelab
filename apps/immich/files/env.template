# Rendered once into /var/lib/homelab/apps/immich/.env and never overwritten,
# so an update cannot rotate the DB password out from under postgres.
#
# IMMICH_VERSION is pinned on purpose. An Immich release can migrate the
# database, and the phone apps must match the server. Bump it here, then
# `homelab update immich --apply`, and read the release notes first:
# https://github.com/immich-app/immich/releases
IMMICH_VERSION=v3.2.0
IMMICH_PORT=2283
TZ=Asia/Jerusalem

# Postgres. Immich requires A-Za-z0-9 only in the password, which is what
# @@SECRET@@ generates.
DB_USERNAME=postgres
DB_PASSWORD=@@SECRET:32@@
DB_DATABASE_NAME=immich
