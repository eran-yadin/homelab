# Rendered once into /var/lib/homelab/apps/immich/.env and never overwritten,
# so an update cannot rotate the DB password out from under postgres.
#
# `release` is Immich's floating tag for the newest release. `homelab update
# immich` pulls it, shows the version jump, backs up the database first and
# asks before recreating. Pin a version here instead if you want updates to
# stop until you edit this file. Release notes:
# https://github.com/immich-app/immich/releases
IMMICH_VERSION=release
IMMICH_PORT=2283
TZ=Asia/Jerusalem

# Postgres. Immich requires A-Za-z0-9 only in the password, which is what
# @@SECRET@@ generates.
DB_USERNAME=postgres
DB_PASSWORD=@@SECRET:32@@
DB_DATABASE_NAME=immich
